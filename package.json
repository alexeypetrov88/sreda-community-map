{
  "name": "sreda-community-map",
  "version": "1.0.0",
  "private": true,
  "description": "A private, city-level Telegram community map for home locations and travel plans.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexeypetrov88/sreda-community-map.git"
  },
  "bugs": {
    "url": "https://github.com/alexeypetrov88/sreda-community-map/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:security && npm run build && node --test tests/rendered-html.test.mjs",
    "test:security": "node --experimental-strip-types --experimental-sqlite --test tests/security.test.ts tests/migration.test.mjs",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "leaflet": "1.9.4",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "5.20260724.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "brace-expansion": "5.0.8",
    "fast-uri": "3.1.4",
    "js-yaml": "4.3.0",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
