BOT_TOKEN=123456789:replace-with-botfather-token
# Each configured username can bootstrap one admin account and is then pinned
# to that account's immutable numeric Telegram identity.
SREDA_ADMIN_IDS=
SREDA_ADMIN_USERNAMES=alexey_petrov,zhidkovakate
SREDA_APP_URL=https://your-private-mini-app.example
# 16-64 random URL-safe characters. Share only through Sreda's private
# Telegram deep link: https://t.me/YOUR_BOT?start=THIS_VALUE
SREDA_JOIN_CODE=replace-with-a-long-random-invitation-code
# Telegram allows 1-256 characters; use at least 32 random characters here.
TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
GEOCODER_CONTACT=admin@example.com
# Optional: switch away from the public Nominatim endpoint without a code change.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
